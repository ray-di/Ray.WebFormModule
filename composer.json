{
    "name": "ray/web-form-module",
    "description": "Web Form module for Ray.Di",
    "keywords": [
        "web form",
        "Ray.Di module"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "aura/filter": "^2.3|3.x-dev",
        "aura/html": "^2.5",
        "aura/input": "^1.2",
        "doctrine/annotations": "^1.13 || ^2.0",
        "ray/aura-session-module": "^1.1",
        "ray/di": "^2.7"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.4",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "aura/installer-default": true,
            "bamarni/composer-bin-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "Ray\\WebFormModule\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ray\\WebFormModule\\": ["tests/", "tests/Fake"]
        }
    },
    "scripts": {
        "test": "phpunit --log-junit=build/junit.xml",
        "tests": ["@cs", "@sa", "@test"],
        "coverage": ["php -dzend_extension=xdebug.so -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-text --coverage-html=build/coverage"],
        "pcov": ["php -dextension=pcov.so -d pcov.enabled=1 ./vendor/bin/phpunit --coverage-text --coverage-html=build/coverage --coverage-clover=coverage.xml"],
        "cs": ["vendor-bin/tools/vendor/squizlabs/php_codesniffer/bin/phpcs --standard=./phpcs.xml src tests"],
        "cs-fix": ["vendor-bin/tools/vendor/squizlabs/php_codesniffer/bin/phpcbf src tests"],
        "sa": ["vendor-bin/tools/vendor/vimeo/psalm/psalm -m -c psalm.xml --show-info=false", "vendor-bin/tools/vendor/phpstan/phpstan/phpstan analyse -c phpstan.neon --no-progress"]
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
